<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Driveways</AssemblyName>
    <RootNamespace>Driveways</RootNamespace>
    <DebugType>none</DebugType>
    <!-- the generator and the tests are projects of their own, in folders under this one -->
    <DefaultItemExcludes>$(DefaultItemExcludes);generator/**;tests/**;pack/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- compile against Simitone. the pack must not ship Simitone's files: the game shares its own with it -->
    <ProjectReference Include="$(SimitonePath)\Client\Simitone\Simitone.Client\Simitone.Client.csproj" Private="false" />
  </ItemGroup>

  <!-- after building, put the pack's code beside its content in pack/driveways/, ready to copy into Simitone's Packs folder.
       the object file under pack/driveways/content is committed: it is data, written by the generator -->
  <Target Name="MakePackFolder" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);pack.json" DestinationFolder="$(MSBuildProjectDirectory)\pack\driveways" />
  </Target>

</Project>
