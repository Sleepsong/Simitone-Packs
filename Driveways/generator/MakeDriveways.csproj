<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- the object file is written with the same code Simitone reads it with -->
    <ProjectReference Include="$(SimitonePath)\FreeSO\TSOClient\tso.files\FSO.Files.csproj" />
    <!-- the ids and sizes the objects share with the pack's code -->
    <Compile Include="..\Shared.cs" />
    <!-- painting the driveway with a floor tile happens in the game; the generator runs it on a made-up tile, to check it -->
    <Compile Include="..\FloorDress.cs" />
  </ItemGroup>

</Project>
