<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks that another pack reaches Memories' life events, with both loaded as Simitone loads packs.
       This program must not refer to Memories itself: if it did, Memories would be among the game's own
       assemblies, and every pack would share that copy whatever this pack does. So the two packs are built,
       not referenced, and put in pack folders beside the program. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SimitonePath)\Client\Simitone\Simitone.Client\Simitone.Client.csproj" />
    <ProjectReference Include="..\..\Memories.csproj" ReferenceOutputAssembly="false" OutputItemType="MemoriesPackAssembly" />
    <ProjectReference Include="..\consumer\Consumer.csproj" ReferenceOutputAssembly="false" OutputItemType="ConsumerPackAssembly" />
  </ItemGroup>

  <Target Name="PutPacksBeside" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)packs" />
    <Copy SourceFiles="@(MemoriesPackAssembly)" DestinationFolder="$(OutDir)packs\memories" />
    <Copy SourceFiles="@(ConsumerPackAssembly)" DestinationFolder="$(OutDir)packs\consumer" />
  </Target>

</Project>
