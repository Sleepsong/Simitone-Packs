// Every number the Wants, Fears and Aspirations pack plays by. Edit it in the pack's folder, then type
// "aspire reload" in the cheat console (Ctrl+Shift+C) to use it at once, or restart Simitone. If the file
// cannot be read, the log says why and the pack uses the copy it was built with. README.md explains each part.
//
// Points: a want is worth points. Fulfilling it adds them to the Sim's reward points, and moves the meter up by
// points x meter.perPoint. A fear that comes true moves the meter down the same way, but takes no reward points.
// The meter runs from -100 to 100.
{
  "slots": { "wants": 4, "fears": 3, "locks": 1 },

  "meter": {
    "perPoint": 0.01,
    // how far an hour in the best of moods (100) lifts the meter; the worst (-100) lowers it as far
    "moodPerHour": 0.8,
    "start": 0,
    // once a lifetime want is fulfilled, the meter never goes below this (Gold)
    "lifetimeFloor": 55,
    "failure": {
      // falling into aspiration failure is a breakdown: these needs drop at once
      "breakdown": { "Fun": -40, "Social": -40, "Comfort": -20 },
      // after this many hours of failure the Sim pulls themselves together, to this meter (0: never)
      "recoverHours": 24,
      "recoverTo": -45,
      "margin": 10
    }
  },

  // from: where on the meter the level starts. decayPerHour: how far the meter falls each hour there, before
  // mood. needDecay: how fast needs fall there (1 as the game has it). backfire: the chance a reward goes wrong.
  "levels": [
    { "name": "Aspiration Failure", "from": -100, "decayPerHour": 0,   "needDecay": 1.15, "backfire": 0.6 },
    { "name": "Low",                "from": -70,  "decayPerHour": 0.3, "needDecay": 1.05, "backfire": 0.3 },
    { "name": "Steady",             "from": -20,  "decayPerHour": 0.6, "needDecay": 1.0,  "backfire": 0.05 },
    { "name": "Gold",               "from": 50,   "decayPerHour": 1.2, "needDecay": 0.9,  "backfire": 0 },
    { "name": "Platinum",           "from": 85,   "decayPerHour": 2.4, "needDecay": 0.75, "backfire": 0 }
  ],

  "relationships": {
    "friendDaily": 50,
    "bestLifetime": 70,
    "bestDaily": 90,
    // where the game marks love: not yet checked against the game. Aspirations.log lists what it sees
    "loveIndex": 1,
    "loveMask": 2
  },

  // fit: how chance chooses an aspiration for a Sim nobody chose one for. Traits (Neat, Outgoing, Active,
  // Playful, Nice) and skills count 0 to 1; so do HasJob, JobLevel, HasChildren and Friends (up to 10).
  "aspirations": [
    { "id": "Romance", "name": "Romance", "about": "Lives for flirting, kissing and falling in love, many times over.",
      "fit": { "Playful": 1.0, "Outgoing": 0.8, "Body": 0.6, "Charisma": 0.4 } },
    { "id": "Family", "name": "Family", "about": "Wants a partner, children and a happy home.",
      "fit": { "Nice": 1.0, "Neat": 0.4, "Cooking": 0.4, "HasChildren": 1.2 } },
    { "id": "Fortune", "name": "Fortune", "about": "Wants money, a career at the top, and the things money buys.",
      "fit": { "Active": 0.4, "HasJob": 0.6, "JobLevel": 1.2, "Logic": 0.3, "Charisma": 0.3 } },
    { "id": "Popularity", "name": "Popularity", "about": "Wants friends, parties and to be liked by everyone.",
      "fit": { "Outgoing": 1.2, "Charisma": 0.6, "Friends": 1.0 } },
    { "id": "Knowledge", "name": "Knowledge", "about": "Wants to learn every skill there is.",
      "fit": { "Logic": 1.0, "Creativity": 0.6, "Mechanical": 0.6, "Cooking": 0.3, "Neat": 0.2 } },
    { "id": "Pleasure", "name": "Pleasure", "about": "Wants to have a good time, now, and as often as possible.",
      "fit": { "Playful": 1.2, "Active": 0.3, "Outgoing": 0.4 } },
    { "id": "GrowUp", "name": "Grow Up", "child": true, "about": "A child's aspiration: good grades, friends, skills and fun." }
  ],

  // kind: what the want is (see README.md). weights: how likely it is to be rolled for each aspiration ("Any" for
  // the rest). points: what it is worth; perLevel: more for each level the Sim has in the skill or career.
  // ages: "adult", "child" or "any". Interactions are matched by words in their names, in the English game.
