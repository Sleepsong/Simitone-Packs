<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>OpenForBusiness</AssemblyName>
    <RootNamespace>OpenForBusiness</RootNamespace>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- compile against Simitone. the pack must not ship Simitone's files: the game shares its own with it -->
    <ProjectReference Include="$(SimitonePath)\Client\Simitone\Simitone.Client\Simitone.Client.csproj" Private="false" />
  </ItemGroup>

  <!-- after building, put just the pack's own files in pack/openforbusiness/, ready to copy into Simitone's Packs folder -->
  <Target Name="MakePackFolder" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);pack.json" DestinationFolder="$(MSBuildProjectDirectory)\pack\openforbusiness" />
  </Target>

</Project>
